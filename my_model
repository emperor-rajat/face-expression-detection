import torch
import torch.nn as nn
import torch.nn.functional as F

class Deep_Emotion(nn.Module):
  def __init__(self):
    super().__init__()

    self.localization = nn.Sequential(
        nn.Conv2d(1,8,7),
        nn.MaxPool2d(2,2),
        nn.ReLU(),
        nn.Conv2d(8,10,5),
        nn.MaxPool2d(2,2),
        nn.ReLU()
    )

    self.fc_loc = nn.Sequential(
        nn.Linear(640,32),
        nn.ReLU(),
        nn.Linear(32,6)
    )

    

    self._init_stn_weights()

    self.features = nn.Sequential(
        nn.Conv2d(1,10,3),
        nn.ReLU(),
        nn.Conv2d(10,10,3),
        nn.ReLU(),
        nn.MaxPool2d(2,2),
        nn.Conv2d(10,10,3),
        nn.ReLU(),
        nn.Conv2d(10,10,3),
        nn.BatchNorm2d(10),
        nn.ReLU(),
        nn.MaxPool2d(2,2),
        nn.Dropout(),
        nn.Flatten()
    )


    self.classifier = nn.Sequential(
        nn.Linear(810,50),
        nn.ReLU(),
        nn.Linear(50,7)
    )

  def _init_stn_weights(self):
    self.fc_loc[2].weight.data.zero_()
    self.fc_loc[2].bias.data.copy_(torch.tensor([1,0,0,0,1,0],dtype=torch.float))



  def stn(self,x):
    xs = self.localization(x)
    xs = xs.flatten(1)
    theta = self.fc_loc(xs).view(-1,2,3)
    grid = F.affine_grid(theta, x.size(), align_corners=True)
    return F.grid_sample(x, grid, align_corners=True)


  def forward(self,x):
    x= self.stn(x)
    x= self.features(x)
    x= self.classifier(x)
    return x
