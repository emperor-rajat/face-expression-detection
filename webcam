def main():
    detector = EmotionDetector("emotion_model_traced.pt")
    cap = cv2.VideoCapture(0)
    print("Press 'q' to quit")

    while True:
        success, frame = cap.read()
        if not success:
            break
        
        results = detector.detect_emotion(frame)
        frame_with_results = detector.draw_results(frame, results)

        cv2.imshow("Emotion Detection", frame_with_results)

        if cv2.waitKey(1) & 0xFF == ord("q"):
            break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
